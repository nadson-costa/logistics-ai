# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=logistics_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5005

# Inspeção
VIDEO_SOURCE_PATH=data/raw/esteira.mp4
FRAME_SAMPLE_RATE=10
DEFECT_CLASS_NAME=caixa_danificada

# Notificações (janela de agregação em segundo)
NOTIFICATION_WINDOW_SECONDS=300

# Notificação por e-mail via Resend (opcional — canal fica desativado se omitido)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL_FROM=alerts@seu-dominio.com
NOTIFICATION_EMAIL_TO=voce@seu-dominio.com

# Notificação por SMS via Twilio (opcional — canal fica desativado se omitido)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SENDER=+15550000000
TWILIO_RECIPIENT=+15550000000
